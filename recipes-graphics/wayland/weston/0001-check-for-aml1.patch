From d8675a44c43293a04778148a5787d60f1faa3290 Mon Sep 17 00:00:00 2001
From: Robert Woerle <rwoerle@mibtec.de>
Date: Sat, 13 Sep 2025 09:35:40 +0000
Subject: [PATCH] check for aml1

Signed-off-by: Robert Woerle <rwoerle@mibtec.de>
---
 libweston/backend-vnc/meson.build | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libweston/backend-vnc/meson.build b/libweston/backend-vnc/meson.build
index d51d74c..0f14671 100644
--- a/libweston/backend-vnc/meson.build
+++ b/libweston/backend-vnc/meson.build
@@ -8,7 +8,7 @@ if not dep_neatvnc.found()
 	error('VNC backend requires neatvnc which was not found. Or, you can use \'-Dbackend-vnc=false\'.')
 endif
 
-dep_aml = dependency('aml', version: ['>= 0.3.0', '< 1.1.0'], required: false, fallback: ['aml', 'aml_dep'])
+dep_aml = dependency('aml1', version: ['>= 0.3.0', '< 1.1.0'], required: false, fallback: ['aml', 'aml_dep'])
 if not dep_aml.found()
 	error('VNC backend requires libaml which was not found. Or, you can use \'-Dbackend-vnc=false\'.')
 endif
